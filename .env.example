# ============================================
# SOLIDES - Konfigurasi Lingkungan (.env)
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` (berisi kredensial).
# File ini dibaca otomatis oleh config/dotenv.php.
# ============================================

# Mode aplikasi: prod (sembunyikan error) / dev (tampilkan error)
APP_ENV=prod

# --- Database aplikasi (wajib diisi) ---
DB_HOST=localhost
DB_USER=ganti_user_db
DB_PASS=ganti_password_db
DB_NAME=spk_supplier

# --- phpMyAdmin (kredensial admin DB; tidak dibaca aplikasi) ---
DB_ADMIN_USER=ganti_admin_db
DB_ADMIN_PASS=ganti_password_admin_db
